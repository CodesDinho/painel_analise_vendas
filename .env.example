PAINEL_PORT=8520
PAINEL_ANALISE_VENDAS_IMAGE=ghcr.io/codesdinho/painel-analise-vendas:latest
PAINEL_HOST_ROOT=/home/administrator/Desktop/codes/Painel_analise_vendas
ANALISE_VENDAS_COMBO_AUDIT_API_URL=http://slack-combos:8080
ANALISE_VENDAS_COMBO_AUDIT_API_TOKEN=defina_um_segredo_com_ao_menos_32_caracteres
ANALISE_VENDAS_COMBO_AUDIT_API_TIMEOUT=45
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/credential.json
ANALISE_VENDAS_GCP_PROJECT=dinho-dw
ANALISE_VENDAS_USUARIOS_PATH=/app/config_runtime/usuarios.json
ANALISE_VENDAS_USUARIOS_FATURAMENTO_PATH=/app/config_runtime/usuarios_faturamento.json
ANALISE_VENDAS_FIREBIRD_HOST=servidor-firebird
ANALISE_VENDAS_FIREBIRD_DATABASE=/caminho/do/banco.fdb
ANALISE_VENDAS_FIREBIRD_USER=usuario
ANALISE_VENDAS_FIREBIRD_PASSWORD=senha
ANALISE_VENDAS_FIREBIRD_CHARSET=UTF8
